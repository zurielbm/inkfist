# Copy to .env on the VPS (next to docker-compose.yml). .env is git-ignored.
# Your domain, with an A record pointing at the VPS (used by the Caddy HTTPS proxy).
DOMAIN=inkfist.example.com
# Optional: the server's public URL, as players and agents reach it (otherwise taken from the proxy's headers).
PUBLIC_API=https://inkfist.example.com
# Where spectator links send people (the game).
GAME_URL=https://pages.subir.dev/inkfist/
# Host port for the server (default 8787). With Caddy in front, 127.0.0.1:8787 keeps plain HTTP off the internet.
# INKFIST_PORT=127.0.0.1:8787
# Behind Cloudflare's orange proxy or a Cloudflare Tunnel, take the client address from Cloudflare's header.
# IP_HEADER=cf-connecting-ip
